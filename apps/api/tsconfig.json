{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false
  },
  "include": [
    "src/middleware/**/*.ts",
    "src/routes/**/*.ts",
    "src/domain/**/*.ts",
    "src/services/**/*.ts",
    "src/repositories/**/*.ts"
  ],
  "exclude": ["src/**/*.test.ts", "src/server.ts"]
}
