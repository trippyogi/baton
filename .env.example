# BATON - Environment Variables

# Server port. BATON_PORT is preferred; VMC_PORT and PORT remain supported fallbacks.
BATON_PORT=4200
# VMC_PORT=4200
# PORT=4200

# Server bind host. Defaults to 127.0.0.1; use a specific private IP for tailnet/LAN hosting.
BATON_HOST=127.0.0.1
# HOST=127.0.0.1

# Bearer token required for /api routes when BATON_HOST/HOST binds outside localhost; optional on localhost.
BATON_API_TOKEN=

# GitHub Webhook
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here
GITHUB_WORKER_TOKEN=your-github-personal-access-token

# Redis (optional for local Flow development)
REDIS_URL=redis://127.0.0.1:6379

# Shared Requests (optional, token-protected)
SHARED_REQUESTS_TOKEN=change-me-local-token

# BATON public callback base for agents. For remote agents, set this to a tunnel/public URL.
BATON_PUBLIC_BASE_URL=http://127.0.0.1:4200

# Optional callback auth used by /api/runs/:id/ack and /api/runs/:id/status.
BATON_CALLBACK_TOKEN=change-me

# Spectre dispatch v1 reference integration
SPECTRE_DISPATCH_TRANSPORT=webhook
SPECTRE_WEBHOOK_URL=http://127.0.0.1:4300/baton/dispatch
SPECTRE_DISPATCH_TOKEN=change-me

# Local Nectar bridge dispatch reference integration
# Start with: NECTAR_DISPATCH_TOKEN=change-me npm run bridge:nectar
NECTAR_WEBHOOK_URL=http://127.0.0.1:4310/baton/dispatch
NECTAR_DISPATCH_TOKEN=change-me
# Optional: where the local bridge writes accepted dispatch inbox records.
# NECTAR_DISPATCH_INBOX=local/nectar-dispatch-inbox
