{
  "name": "baton",
  "version": "0.1.0",
  "description": "BATON human-attention control plane",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "main": "server/index.js",
  "scripts": {
    "start": "node apps/api/bootstrap.cjs",
    "start:legacy": "node server/index.js",
    "dev": "node apps/api/bootstrap.cjs",
    "build": "npm run build -w @baton/contracts && npm run build -w @baton/api && npm run build -w @baton/web",
    "typecheck": "npm run typecheck -w @baton/contracts && npm run typecheck -w @baton/api && npm run typecheck -w @baton/sdk && npm run typecheck -w @baton/web",
    "dev:web": "npm run dev -w @baton/web",
    "check:js": "node scripts/check-js.js",
    "migrate": "node scripts/migrate.js",
    "test:migrations": "node scripts/test-migrations.js",
    "smoke": "node scripts/smoke-flow.js",
    "audit": "npm audit --audit-level=moderate --omit=dev",
    "audit:private": "node scripts/audit-private-data.js",
    "import:local": "node scripts/import-local-profile.js",
    "export:redacted": "node scripts/export-redacted.js",
    "test": "npm run check:js && npm run build && npm run typecheck && npm run test -w @baton/contracts && npm run test -w @baton/api && npm run test:migrations && npm run smoke",
    "test:unit": "npm run test -w @baton/contracts && npm run test -w @baton/api && npm run test -w @baton/sdk",
    "generate:json-schema": "npm run generate:json-schema -w @baton/contracts",
    "preinstall": "node -e \"const major=process.versions.node.split('.')[0]; if(major !== '24'){ console.error('BATON requires Node 24. Run: nvm use'); process.exit(1); }\"",
    "fake:spectre": "node scripts/fake-spectre.js",
    "smoke:dispatch": "node scripts/smoke-dispatch-spectre.js",
    "test:e2e": "node scripts/e2e-web.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "esbuild"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trippyogi/baton.git"
  },
  "bugs": {
    "url": "https://github.com/trippyogi/baton/issues"
  },
  "homepage": "https://github.com/trippyogi/baton#readme",
  "engines": {
    "node": ">=24 <25"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.1": true
  }
}
