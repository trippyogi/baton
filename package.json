{
  "name": "baton",
  "version": "0.3.0",
  "description": "A ranking engine for human attention in multi-agent systems.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "check:js": "node scripts/check-js.js",
    "doctor": "node scripts/doctor.js",
    "smoke": "node scripts/smoke-flow.js",
    "audit": "npm audit --audit-level=moderate --omit=dev",
    "audit:private": "node scripts/audit-private-data.js",
    "check:private": "npm run audit:private && npm run import:local -- scripts/fixtures/private-local-profile.example.json --dry-run && npm run import:local -- scripts/fixtures/nectar-local-agent.example.json --dry-run",
    "import:local": "node scripts/import-local-profile.js",
    "export:redacted": "node scripts/export-redacted.js",
    "agent:setup": "node scripts/agent-folder-bridge.js --setup",
    "agent:sync": "node scripts/agent-folder-bridge.js --sync",
    "test": "npm run check:js && npm run smoke && npm run adversarial:loop",
    "preinstall": "node -e \"const major=Number(process.versions.node.split('.')[0]); if(major < 20){ console.error('BATON requires Node 20+. Recommended: nvm use'); process.exit(1); } console.warn('BATON is tested on Node 20/22; continuing on '+process.version);\"",
    "fake:spectre": "node scripts/fake-spectre.js",
    "fake:agent": "node scripts/fake-spectre.js",
    "bridge:nectar": "node scripts/nectar-dispatch-bridge.js",
    "bridge:local": "node scripts/nectar-dispatch-bridge.js",
    "check:nectar-bridge": "node scripts/nectar-dispatch-bridge.js --check-env",
    "check:local-bridge": "node scripts/nectar-dispatch-bridge.js --check-env",
    "smoke:dispatch": "node scripts/smoke-dispatch-spectre.js",
    "smoke:nectar": "node scripts/smoke-nectar-dispatch.js",
    "smoke:local-bridge": "node scripts/smoke-nectar-dispatch.js",
    "adversarial:loop": "node scripts/adversarial/loop-integrity.js",
    "demo": "node scripts/seed-demo.js",
    "demo:clean": "node scripts/seed-demo.js --clean",
    "reset": "node scripts/reset.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "ioredis": "^5.11.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trippyogi/baton.git"
  },
  "bugs": {
    "url": "https://github.com/trippyogi/baton/issues"
  },
  "homepage": "https://github.com/trippyogi/baton#readme",
  "engines": {
    "node": ">=20 <25"
  }
}
